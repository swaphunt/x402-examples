# Wallet private key used to pay for x402 calls (0x-prefixed hex).
# Use a dedicated wallet with a few dollars of USDC on Base mainnet.
# Never your main wallet. Never commit your real .env.
PRIVATE_KEY=

# Examples run as a dry run by default: they show the price, network and
# payTo address from the 402 response without paying.
# Set X402_PAY=1 (or pass --pay) to actually pay.
X402_PAY=

# Hard spending cap per run, in USD. Examples stop before exceeding it.
MAX_SPEND_USD=0.10

# --- daily-brief ---------------------------------------------------

# LLM used to write the brief: anthropic (default), ollama (local, free) or none (raw data).
LLM_PROVIDER=anthropic
# Empty = provider default: claude-haiku-5-5 (anthropic), qwen3.5:9b (ollama).
LLM_MODEL=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# Where to deliver: stdout (default), telegram, discord or email.
# (alert-bot always uses Telegram and needs TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.)
DELIVERY=stdout

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=

# --- alert-bot -------------------------------------------------------------

ALERT_ASSET=BTC
# Set exactly one of these (USD price level):
ALERT_BELOW=
ALERT_ABOVE=
ALERT_INTERVAL_MIN=15
# Remembers the last state so cron runs (--once) alert only on a new crossing.
ALERT_STATE_FILE=
