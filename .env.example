# Wallet private key used to pay for x402 calls (0x-prefixed hex).
# Use a dedicated wallet with a small balance. Never commit your real .env.
PRIVATE_KEY=

# Network: base-sepolia (testnet, default) or base (mainnet).
X402_NETWORK=base-sepolia

# Hard spending cap per run, in USD. Examples stop before exceeding it.
MAX_SPEND_USD=0.10
